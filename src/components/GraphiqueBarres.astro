---
/**
 * Barres horizontales en HTML/CSS : lisibles à toutes les largeurs, valeurs écrites
 * en clair sur chaque barre (pas besoin de survol). Une barre peut être une fourchette.
 */
interface Barre {
  libelle: string;
  valeur: number;
  max?: number;
  dont?: { valeur: number; libelle: string };
  detail?: string;
  sourceLabel: string;
  sourceUrl: string;
  accent: boolean;
}
interface Props {
  titre: string;
  unite: '%' | 'Md€' | 'nombre';
  barres: Barre[];
  note?: string;
  verifie: boolean;
  champ?: string; // chemin du graphique dans la fiche, pour l'édition sur la page (en local)
}
import CaseEdition from './CaseEdition.astro';
const { titre, unite, barres, note, verifie, champ } = Astro.props;
const ed = (cle: string) => (champ ? { 'data-champ': `${champ}.${cle}`, 'data-format': 'texte' } : {});

const echelle = Math.max(...barres.map((b) => b.max ?? b.valeur));
const nombre = (v: number) => v.toLocaleString('fr-FR', { maximumFractionDigits: 1 });
const avecUnite = (v: string) => (unite === 'nombre' ? v : `${v} ${unite}`);
const texte = (b: Barre) =>
  b.max != null ? avecUnite(`${nombre(b.valeur)} à ${nombre(b.max)}`) : avecUnite(nombre(b.valeur));
// La plus longue barre occupe 72 % de la piste : il reste la place d'écrire la valeur au bout.
const pct = (v: number) => `${((v / echelle) * 72).toFixed(2)}%`;
// Sources uniques, dans l'ordre d'apparition
const sources = [...new Map(barres.map((b) => [b.sourceUrl, b])).values()];
---
<figure class="barres">
  <figcaption>
    <span class="graph-titre" {...ed("titre")}>{titre}</span>
    {!verifie && <span class="unverified"> Données à vérifier</span>}
    <CaseEdition chemin={champ && `${champ}.verifie`} coche={verifie} libelle="Données vérifiées" />
  </figcaption>
  <ul>
    {barres.map((b, k) => (
      <li class={b.accent ? 'accent' : ''}>
        <div class="b-lib">
          <span {...ed(`barres.${k}.libelle`)}>{b.libelle}</span>
          {b.detail && <small {...ed(`barres.${k}.detail`)}>{b.detail}</small>}
        </div>
        <div class="b-piste" role="img" aria-label={`${b.libelle} : ${texte(b)}${b.dont ? `, dont ${avecUnite(nombre(b.dont.valeur))} ${b.dont.libelle}` : ''}`}>
          {b.dont ? (
            <>
              <span class="b-plein b-dont" style={`width:${pct(b.dont.valeur)}`}></span>
              <span class="b-plein b-reste" style={`width:${pct(b.valeur - b.dont.valeur)}`}></span>
            </>
          ) : (
            <span class="b-plein" style={`width:${pct(b.valeur)}`}></span>
          )}
          {b.max != null && <span class="b-fourchette" style={`width:${pct(b.max - b.valeur)}`}></span>}
          <span class="b-val">{texte(b)}</span>
        </div>
        {b.dont && (
          <div class="b-dont-legende">
            <i></i>dont ≈ {avecUnite(nombre(b.dont.valeur))} : {b.dont.libelle}
          </div>
        )}
      </li>
    ))}
  </ul>
  <p class="graph-source">
    Sources : {sources.map((s, i) => (
      <>{i > 0 && ' ; '}<a href={s.sourceUrl} target="_blank" rel="noopener">{s.sourceLabel}</a></>
    ))}.{note && <> <span {...ed("note")}>{note}</span></>}
  </p>
</figure>
